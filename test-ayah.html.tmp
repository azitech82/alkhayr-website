<!DOCTYPE html>
<html>
<head>
    <title>Ayah Test</title>
</head>
<body>
    <div id="ayah-content">
        <div class="text-center py-12">
            <i class="fas fa-spinner fa-spin text-3xl"></i>
            <p class="mt-3 opacity-80 text-base">Fetching Ayah...</p>
        </div>
    </div>
    
    <script>
        (function() {
            console.log('=== STANDALONE AYAH OF THE DAY SCRIPT ===');
            
            function init() {
                const container = document.getElementById('ayah-content');
                console.log('STANDALONE: container found:', container);
                if (!container) {
                    console.log('STANDALONE: container not found');
                    return;
                }
                
                const randomAyah = Math.floor(Math.random() * 6236) + 1;
                console.log('STANDALONE: randomAyah:', randomAyah);
                
                Promise.all([
                    fetch(`https://api.alquran.cloud/v1/ayah/${randomAyah}/quran-uthmani`),
                    fetch(`https://api.alquran.cloud/v1/ayah/${randomAyah}/en.sahih`),
                    fetch(`https://api.alquran.cloud/v1/ayah/${randomAyah}/ms.basmeih`),
                    fetch(`https://api.alquran.cloud/v1/ayah/${randomAyah}/ar.muyassar`)
                ])
                .then(responses => Promise.all(responses.map(r => r.json())))
                .then(([arabic, en, ms, tafsir]) => {
                    console.log('STANDALONE: data received', { arabic, en, ms, tafsir });
                    
                    const ref = `${arabic.data.surah.number}:${arabic.data.numberInSurah}`;
                    const audioKey = `${String(arabic.data.surah.number).padStart(3, '0')}${String(arabic.data.numberInSurah).padStart(3, '0')}`;
                    const audioUrl = `https://www.everyayah.com/data/Abu_Bakr_Ash-Shaatree_64kbps/${audioKey}.mp3`;
                    
                    let html = `
                        <div dir="rtl" style="display: flex; align-items: center; justify-content: center; gap: 1rem; margin-bottom: 1rem;">
                            <div style="font-weight: 700; color: white; font-size: 1.5rem;">${arabic.data.surah.name} (${arabic.data.numberInSurah})</div>
                            <button id="ayah-play-btn" type="button" style="width: 2.5rem; height: 2.5rem; flex-shrink: 0; border-radius: 9999px; background: linear-gradient(135deg, #a855f7, #ec4899); border: 2px solid rgba(255, 255, 255, 0.9); box-shadow: 0 0 12px rgba(236, 72, 153, 0.6), inset 0 0 5px rgba(255, 255, 255, 0.4); display: flex; align-items: center; justify-content: center; color: white; cursor: pointer; transition: all 0.3s ease;" aria-label="Play Ayah">
                                <i class="fas fa-play" style="margin-left: 3px; font-size: 0.9rem;"></i>
                            </button>
                            <audio id="ayah-audio-player" preload="none" src="${audioUrl}"></audio>
                        </div>
                    `;
                    
                    html += `<div style="margin-bottom: 0.75rem; font-size: 0.875rem; color: rgba(255,255,255,0.9);">Reciter: Abu Bakar Syateeri</div>`;
                    
                    html += `<div dir="rtl" style="text-align: right; font-family: 'KFGQPC HAFS Uthmanic Script', 'Amiri', serif; font-size: 1.2rem; line-height: 2.35; margin-bottom: 1rem; color: white;">${arabic.data.text}</div>`;
                    
                    html += `<div style="font-weight: 600; color: #fef08a; margin-bottom: 0.25rem;">English:</div>`;
                    html += `<div style="color: rgba(255,255,255,0.9); margin-bottom: 1rem;">${en.data.text}</div>`;
                    
                    html += `<div style="font-weight: 600; color: #fef08a; margin-bottom: 0.25rem;">Malay:</div>`;
                    html += `<div style="color: rgba(255,255,255,0.9); margin-bottom: 1rem;">${ms.data.text}</div>`;
                    
                    html += `<div style="font-weight: 600; color: #fef08a; margin-bottom: 0.25rem;">Tafseer:</div>`;
                    html += `<div dir="rtl" style="text-align: right; line-height: 1.8; color: rgba(255,255,255,0.9);">${tafsir.data.text}</div>`;
                    
                    container.innerHTML = html;
                    console.log('STANDALONE: done');
                })
                .catch(err => {
                    console.error('STANDALONE: ERROR', err);
                    container.innerHTML = `<p style="text-align: center; opacity: 0.8; color: #fca5a5;">Failed to load Ayah of the day. Error: ${err.message}</p>`;
                });
            }
            
            init();
            setTimeout(init, 2000);
        })();
    </script>
</body>
</html>
